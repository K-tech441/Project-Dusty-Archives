{
  "name": "@local/dsh-graph-panel",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "在设置面板里查看 Munkres 形式化库的四层声明图（读 knowledge/pipeline/graph.json）：可缩放/拖拽/搜索/按模块过滤。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-settings"]
    }
  },
  "meta": {
    "title": "知识图谱",
    "description": "Munkres 形式化库的四层声明图：节点=声明，边=提及（A/B/I/R），可缩放拖拽搜索。"
  }
}
